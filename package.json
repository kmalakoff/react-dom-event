{
  "name": "react-dom-event",
  "version": "1.1.0",
  "description": "React context for subscribing to all DOM user interaction events",
  "keywords": [
    "react-native-web",
    "react",
    "native",
    "web",
    "dom",
    "outside",
    "click",
    "press",
    "touch",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmalakoff/react-dom-event.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./umd": "./dist/umd/react-dom-event.cjs"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "npm run test:types && tsds test:browser --config wtr.config.mjs && tsds test:node --no-timeouts --ignore test/exports/umd-browser.test.ts",
    "test:engines": "tsds test:browser --config wtr.config.mjs && nvu engines tsds test:node --no-timeouts --ignore test/exports/umd-browser.test.ts",
    "test:types": "npm run build && node test/types/run.mjs",
    "version": "tsds version"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@web/dev-server-import-maps": "^0.3.0",
    "fs-remove-compat": "*",
    "jsdom": "^30.0.1",
    "node-version-use": "*",
    "react": "*",
    "react-dom": "*",
    "semver": "^7.8.5",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-web-test-runner": "*"
  },
  "peerDependencies": {
    "react": "*"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "esbuild": true
  },
  "tsds": {
    "targets": [
      "cjs",
      "esm",
      "umd"
    ],
    "globals": {
      "react": "React"
    }
  }
}
